<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed because the server is self-hosted and usually reached
  over plain http on a LAN (http://192.168.1.10:3000). The address is the
  user's own choice, so there is no fixed domain list to scope this to. Remote
  access is expected to go through a reverse proxy with HTTPS; README.md says so.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
