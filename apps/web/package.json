{
  "name": "@tinkerbell/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#pages/*": "./src/pages/*",
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*",
    "#hooks/*": "./src/hooks/*",
    "#layout/*": "./src/layout/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --experimental-strip-types 'src/**/*.test.ts'",
    "build:native": "vite build --mode native --outDir dist-native --emptyOutDir",
    "native:sync": "pnpm build:native && cap sync"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@tinkerbell/contracts": "workspace:*",
    "@tinkerbell/llm": "workspace:*",
    "@tinkerbell/native-client": "workspace:*",
    "@tinkerbell/plex-smart-filter": "workspace:*",
    "@tinkerbell/trpc": "workspace:*",
    "@trpc/client": "^11.10.0",
    "@trpc/react-query": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "croner": "^9.0.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "opentype.js": "1.3.4",
    "p-map": "^7.0.4",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
