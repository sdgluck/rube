{
  "name": "@rube/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#pages/*": "./src/pages/*",
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*",
    "#hooks/*": "./src/hooks/*",
    "#layout/*": "./src/layout/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@rube/contracts": "workspace:*",
    "@rube/llm": "workspace:*",
    "@rube/plex-smart-filter": "workspace:*",
    "@rube/trpc": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.10.0",
    "@trpc/react-query": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "croner": "^9.0.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "opentype.js": "1.3.4",
    "p-map": "^7.0.4",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
