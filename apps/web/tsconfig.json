{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#/*": ["./src/*"],
      "#pages/*": ["./src/pages/*"],
      "#lib/*": ["./src/lib/*"],
      "#components/*": ["./src/components/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#layout/*": ["./src/layout/*"]
    }
  },
  "include": ["src"]
}
