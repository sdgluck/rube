{
  "name": "@rube/rube.fyi",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#pages/*": "./src/pages/*",
    "#components/*": "./src/components/*",
    "#data/*": "./src/data/*",
    "#registry/*": "./src/registry/*"
  },
  "scripts": {
    "dev": "pnpm build:registry && vite",
    "prebuild": "pnpm build:registry",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:registry": "node --experimental-strip-types scripts/build-registry.ts",
    "test": "node --test --experimental-strip-types 'src/registry/**/*.test.ts'",
    "typecheck": "tsc",
    "capture": "node --experimental-strip-types harness/capture.ts",
    "serve": "node --experimental-strip-types harness/serve.ts",
    "test:coverage": "node --test --experimental-test-coverage --experimental-strip-types 'src/registry/**/*.test.ts'",
    "native-serve": "node --experimental-strip-types harness/native-serve.ts"
  },
  "dependencies": {
    "@rube/contracts": "workspace:*",
    "@rube/plex-smart-filter": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@rube/core": "workspace:*",
    "@rube/db": "workspace:*",
    "@rube/test-support": "workspace:*",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.50.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
