{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "#/*": ["./src/*"],
      "#pages/*": ["./src/pages/*"],
      "#components/*": ["./src/components/*"],
      "#data/*": ["./src/data/*"],
      "#registry/*": ["./src/registry/*"]
    },
    "incremental": true
  },
  "include": ["src", "harness", "scripts"]
}
