node_modules/
*.db
# Local database backups. `*.db` above doesn't cover the gzipped ones, and a
# dev run writes here because DATA_DIR defaults to the repo root.
#
# Leading slash, or it matches at any depth — a bare `backups/` also swallows
# `domains/backups`, which is source.
/backups/
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
apps/web/dist
apps/portal/dist
.turbo
.claude/*
!.claude/skills/
.idea/
/posters/
.pnpm-store/
.DS_Store

# tsc's incremental state. `incremental: true` is what takes `pnpm typecheck`
# from ~25s to ~5s, which is what makes it affordable in the pre-commit hook —
# but the cache is machine- and version-specific, so it is never committed.
*.tsbuildinfo

# Native (Capacitor) builds. `dist-native` is the SPA bundled into the apps,
# rebuilt by `pnpm native:sync`; the platform folders' own build output is
# ignored by the .gitignore files Capacitor generated inside them. Signing keys
# never belong in the repo.
dist-native/
*.jks
*.keystore

# The recommender model. `models/recs.json` (committed) pins it; the file is a
# `recs-v*` release asset that `scripts/fetch-recs-model.mjs` downloads, since
# committing ~25MB per retrain would grow the repo's history forever.
/models/recs.bin
