{
  "name": "tinkerbell",
  "version": "0.43.0",
  "description": "",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm db:migrate && node scripts/fetch-recs-model.mjs && node scripts/dev.mjs",
    "proxy:up": "node scripts/proxy.mjs up",
    "proxy:down": "node scripts/proxy.mjs down",
    "proxy:status": "localias status",
    "build": "turbo run build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "screenshots": "node scripts/capture-docker.mjs",
    "screenshots:local": "pnpm format && pnpm --filter @tinkerbell/tinkerbell.dev capture",
    "db:generate": "pnpm --filter @tinkerbell/db run generate",
    "db:migrate": "pnpm --filter @tinkerbell/db run migrate",
    "lint": "git ls-files -z '*.ts' '*.tsx' | xargs -0 oxlint && git ls-files -z '*.css' | xargs -0 stylelint && node scripts/check-fetch.mjs && node scripts/check-nul.mjs && node scripts/check-button-classes.mjs",
    "format": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' ':!:packages/db/drizzle/**' ':!:apps/*/ios/**' ':!:apps/*/android/**' | xargs -0 oxfmt",
    "format:check": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' ':!:packages/db/drizzle/**' ':!:apps/*/ios/**' ':!:apps/*/android/**' | xargs -0 oxfmt --check",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "lint:css": "git ls-files -z '*.css' | xargs -0 stylelint",
    "lint:css:report": "git ls-files -z '*.css' | xargs -0 stylelint --report-needless-disables --report-invalid-scope-disables",
    "native:codegen": "node packages/native-codegen/src/cli.ts",
    "native:assets": "node scripts/native-assets.mjs",
    "native:sync": "pnpm --filter @tinkerbell/web --filter @tinkerbell/portal run native:sync",
    "native:ios": "node scripts/native.mjs ios",
    "native:android": "node scripts/native.mjs android",
    "recs:fetch": "node scripts/fetch-recs-model.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  }
}
