{
  "name": "tinkerbell",
  "version": "0.14.3",
  "description": "",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm db:migrate && node scripts/dev.mjs",
    "proxy:up": "node scripts/proxy.mjs up",
    "proxy:down": "node scripts/proxy.mjs down",
    "proxy:status": "localias status",
    "build": "turbo run build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "turbo run test",
    "screenshots": "node scripts/capture-docker.mjs",
    "screenshots:local": "pnpm format && pnpm --filter @tinkerbell/tinkerbell.dev capture",
    "db:generate": "pnpm --filter @tinkerbell/db run generate",
    "db:migrate": "pnpm --filter @tinkerbell/db run migrate",
    "lint": "git ls-files -z '*.ts' '*.tsx' | xargs -0 oxlint && node scripts/check-fetch.mjs && node scripts/check-nul.mjs",
    "format": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' | xargs -0 oxfmt",
    "format:check": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' | xargs -0 oxfmt --check",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  }
}
