{
  "name": "tinkerbell",
  "version": "0.4.1",
  "description": "",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tinkerbell/db run db:generate",
    "db:migrate": "pnpm --filter @tinkerbell/db run db:migrate",
    "lint": "git ls-files -z '*.ts' '*.tsx' | xargs -0 oxlint",
    "format": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' | xargs -0 oxfmt",
    "format:check": "git ls-files -z '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md' | xargs -0 oxfmt --check",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "portless": "^0.12.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  }
}
