{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/parameter-properties": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@rube/server", "@rube/server/*", "**/apps/server/**"],
                "message": "Cross-app imports are forbidden. Web must consume server code via @rube/contracts or @rube/trpc (type only)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@rube/web", "@rube/web/*", "**/apps/web/**"],
                "message": "Cross-app imports are forbidden. Server must not depend on web."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.ts", "domains/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@rube/server", "@rube/server/*", "@rube/web", "@rube/web/*", "**/apps/**"],
                "message": "Packages must not depend on apps. Move shared code into a package or invert the dependency."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["domains/**/*.ts", "packages/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@rube/db",
                "importNames": ["createDb", "defaultDataDir"],
                "message": "Only @rube/composition opens the database. Take `db: Db` as a dependency and let the container provide it \u2014 a second connection to the same file is how the import-time singleton behaved, and why tests needed a subprocess."
              },
              {
                "name": "@rube/composition",
                "importNames": ["buildContainer"],
                "message": "Building a container is an entrypoint's job (apps/server, the Sidequest worker, the stress-test worker, test-support). A library that builds its own gets a second object graph, which is the bug this replaced."
              }
            ]
          }
        ]
      },
      "excludeFiles": [
        "packages/composition/**/*.ts",
        "packages/db/**/*.ts",
        "packages/container/**/*.ts",
        "**/*.test.ts",
        "packages/jobs/src/sidequest/job.ts",
        "packages/jobs/src/stress-test/worker.ts"
      ]
    }
  ]
}
