{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["dist/**"]
    },
    /* `pnpm test` does NOT come through here any more — it runs
       `scripts/test.mjs`, one `node --test` process over every test file.
       Fanning the suite out as 63 per-package tasks meant ~110 concurrent node
       processes on a 12-core machine, each re-stripping its whole TypeScript
       import graph: 4m16s at 126% CPU, against 43s for the single runner. The
       turbo cache made repeat runs cheap but the cold run is the one that
       matters before a commit.

       Left registered so `turbo run test` still works for a per-package run
       with caching. */
    "test": {
      "dependsOn": ["^build"],
      /* Without explicit `inputs`, turbo hashes every file in the package —
         including `dist/`, which `^build` has just written, so a rebuilt
         dependency invalidated tests that could not have been affected. With
         them a test run is cached on the sources it actually reads.

         `$TURBO_DEFAULT$` keeps turbo's own defaults (package.json, lockfile,
         tsconfig) and adds the fixtures and migrations that tests load from
         disk: `createTestDb` applies `packages/db/drizzle/**` at run time, and
         the overlay/poster golden images are read rather than imported, so
         neither is visible to turbo as a source without being named. */
      "inputs": ["$TURBO_DEFAULT$", "src/**", "drizzle/**", "!dist/**"],
      /* Nothing is written. Declared rather than left implicit so a future
         reporter that does write a file has to say so. */
      "outputs": [],
      /* `NODE_ENV` changes behaviour under test — `assertSafeOutboundUrl` is a
         no-op outside production — so it has to be part of the cache key. */
      "env": ["NODE_ENV", "RUBE_ALLOW_PRIVATE_OUTBOUND"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "drizzle/**", "!dist/**"],
      "outputs": [],
      "cache": false
    }
  }
}
