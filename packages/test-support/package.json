{
  "name": "@tinkerbell/test-support",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./arr": "./src/mock-arr-server.ts",
    "./lists": "./src/mock-list-server.ts",
    "./plex": "./src/mock-plex-server.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --experimental-strip-types 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^7.0.2"
  }
}
