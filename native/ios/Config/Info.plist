<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys Xcode can't generate from build settings. Everything else
	     (display name, version, scene manifest) comes from INFOPLIST_KEY_*. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fyi.rube.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rube</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- Rube is self-hosted: people reach it on whatever hostname
		     their LAN, NAS or reverse proxy gives it, very often over plain
		     http on a name ATS doesn't count as local (rube.home,
		     a Tailscale name, a bare IP with a port). Arbitrary loads is the
		     only setting that lets those work; the app warns on its own when
		     an http address is off the local network. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
